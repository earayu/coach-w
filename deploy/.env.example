# Copy to deploy/.env on the server (chmod 600). Never commit the real file.

# Public domain with an A record pointing at this host
COACHW_DOMAIN=coach.example.com
# This host's public IPv4, advertised to clients for WebRTC media
NODE_IP=

# LiveKit credentials. Generate: docker run --rm livekit/livekit-server:v1.13.11 generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Default voice provider when the phone chooses "server default": qwen | openrouter | openai | gemini | xai
COACHW_PROVIDER=qwen
# Optional comma-separated allowlist exposed to the app (default: all supported providers)
# COACHW_PROVIDERS=qwen,openrouter,openai,gemini,xai

# Qwen Realtime (DashScope)
DASHSCOPE_API_KEY=
QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-flash
QWEN_VOICE=longanqian_v3.1
QWEN_TURN_DETECTION=server_vad
# silence (ms) that ends the athlete's turn; longer keeps a breathless sentence in one piece
QWEN_VAD_SILENCE_MS=1200

# OpenRouter voice pipeline (STT + LLM + TTS + local Silero VAD; OpenRouter has no /v1/realtime)
# OPENROUTER_API_KEY=
# OPENROUTER_LLM_MODEL=google/gemini-2.5-flash
# OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
# OPENROUTER_STT_LANGUAGE=zh
# OPENROUTER_TTS_MODEL=google/gemini-2.5-flash-tts
# OPENROUTER_TTS_VOICE=Kore
# OPENROUTER_VAD_SILENCE_MS=1200

# OpenAI Realtime (also works with compatible relays via OPENAI_REALTIME_BASE_URL)
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_REALTIME_BASE_URL=
# OPENAI_VAD_SILENCE_MS=1200

# Google Gemini Live
# GOOGLE_API_KEY=
# GEMINI_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_VOICE=Puck

# xAI Grok Voice Realtime
# XAI_API_KEY=
# XAI_REALTIME_MODEL=grok-voice-latest
# XAI_VOICE=Ara
# XAI_VAD_SILENCE_MS=1200

# Invite codes: comma-separated code:name:daily_minutes (codes >= 12 chars: `openssl rand -hex 8`)
COACHW_INVITES=
COACHW_SESSION_MAX_MINUTES=60
COACHW_TOKEN_TTL_S=600
COACHW_QUOTA_TZ=Asia/Shanghai
COACHW_AGENT_IDLE_PROCESSES=2

# Full conversation transcripts (docs/spec.md 11): the agent writes one JSONL per session into the
# `transcripts` volume at /data/transcripts. Set to empty to turn it off.
# COACHW_TRANSCRIPT_DIR=
