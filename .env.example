# Copy to .env (gitignored). Server-side only; never ship these in the app.
# Local development values; production values go in deploy/.env (see deploy/.env.example).

LIVEKIT_URL=ws://127.0.0.1:7880
# URL handed to the phone; defaults to LIVEKIT_URL
# LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-change-me-0123456789abcdef

DASHSCOPE_API_KEY=
QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-flash
QWEN_VOICE=longanqian_v3.1
QWEN_TURN_DETECTION=server_vad
# silence (ms) that ends the athlete's turn; longer keeps a breathless sentence in one piece
QWEN_VAD_SILENCE_MS=1200

# Invite codes: comma-separated code:name:daily_minutes. Codes are at least 12 characters;
# generate one with `openssl rand -hex 8`.
COACHW_INVITES=dev-invite-code-01:dev:120
COACHW_SESSION_MAX_MINUTES=30
COACHW_TOKEN_TTL_S=600
COACHW_QUOTA_TZ=Asia/Shanghai
